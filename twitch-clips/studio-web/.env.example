# --- Tableau de bord (studio-web) ---
API_URL=http://127.0.0.1:8000          # adresse du backend FastAPI

# --- Backend (twitch-clips/api) : à définir dans l'environnement du serveur, jamais dans le navigateur ---
DASHBOARD_TOKEN=                        # obligatoire si le tableau de bord est accessible à distance
TWITCH_CLIENT_ID=                       # facultatif : clips Twitch existants + avatars (dev.twitch.tv, gratuit)
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=                        # facultatif : recherche YouTube (Google Cloud, gratuit)
