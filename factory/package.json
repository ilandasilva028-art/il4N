{
  "name": "tiktok-ai-video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme locale d'analyse et de production de vidéos TikTok verticales (FFmpeg, Piper, Whisper, rendu canvas).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "start": "node scripts/start.mjs start",
    "build": "next build",
    "web": "next dev -p 3210",
    "worker": "tsx engine/jobs/worker.ts",
    "doctor": "tsx engine/cli.ts doctor",
    "analyze": "tsx engine/cli.ts analyze",
    "produce": "tsx engine/cli.ts produce",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "daily": "tsx engine/daily.ts",
    "setup": "npm ci && npx playwright install chromium",
    "setup:python": "uv venv .venv --python 3.11 && VIRTUAL_ENV=.venv uv pip install faster-whisper==1.2.1 piper-tts==1.3.0 'onnxruntime<1.24'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.4.6",
    "playwright": "^1.55.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}