  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false, "allowImportingTsExtensions": true, "skipLibCheck": true, "esModuleInterop": true, "types": ["node"]
